{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "source.inform7",
  "name": "Inform 7",
  "patterns": [
    {
      "include": "#title"
    },
    {
      "include": "#body"
    }
  ],
  "repository": {
    "title": {
      "comment": "The first line of a story is its title line: a quoted title, optionally followed by 'by Author'.",
      "begin": "^\".*$",
      "beginCaptures": {
        "0": {
          "name": "markup.heading.title.inform7 markup.underline.title.inform7"
        }
      },
      "end": "$END",
      "patterns": [
        {
          "include": "#body"
        }
      ]
    },
    "body": {
      "patterns": [
        {
          "include": "#javascriptCommand"
        },
        {
          "include": "#preformInclusion"
        },
        {
          "include": "#comment"
        },
        {
          "include": "#heading"
        },
        {
          "include": "#tableName"
        },
        {
          "include": "#include"
        },
        {
          "include": "#javascriptExecution"
        },
        {
          "include": "#text"
        },
        {
          "include": "#inform6Inclusion"
        }
      ]
    },
    "comment": {
      "comment": "Comments are in square brackets and nest.",
      "name": "comment.block.inform7",
      "begin": "\\[",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.inform7"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.inform7"
        }
      },
      "patterns": [
        {
          "include": "#nestedComment"
        }
      ]
    },
    "nestedComment": {
      "comment": "Inner brackets of a nested comment are not punctuation; they are part of the comment text.",
      "begin": "\\[",
      "end": "\\]",
      "patterns": [
        {
          "include": "#nestedComment"
        }
      ]
    },
    "text": {
      "name": "string.quoted.double.inform7",
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.inform7"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.inform7"
        }
      },
      "patterns": [
        {
          "comment": "A stray closing bracket, or an opening bracket right before the closing quote, is a substitution error.",
          "name": "invalid.illegal.text.substitution.inform7",
          "match": "\\]|\\[(?=\")"
        },
        {
          "include": "#textSubstitution"
        }
      ]
    },
    "textSubstitution": {
      "comment": "Square brackets inside text are substitutions, such as [the noun] or [if the player is in the Lab].",
      "name": "constant.character.escape.text.substitution.inform7",
      "begin": "\\[",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.substitution.begin.inform7"
        }
      },
      "end": "(\\])|([^\"])?(?=\")",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.substitution.end.inform7"
        },
        "2": {
          "name": "invalid.illegal.text.substitution.inform7"
        }
      },
      "patterns": [
        {
          "comment": "Substitutions do not nest.",
          "name": "invalid.illegal.text.substitution.inform7",
          "match": "\\["
        }
      ]
    },
    "heading": {
      "comment": "Headings may optionally end the keyword with a colon. Each level keeps its own scope so themes can style them differently, while all remain markup.heading.",
      "patterns": [
        {
          "name": "markup.heading.volume.inform7",
          "match": "(?i)^\\s*volume:?\\s+.*$"
        },
        {
          "name": "markup.heading.book.inform7",
          "match": "(?i)^\\s*book:?\\s+.*$"
        },
        {
          "name": "markup.heading.part.inform7",
          "match": "(?i)^\\s*part:?\\s+.*$"
        },
        {
          "name": "markup.heading.chapter.inform7",
          "match": "(?i)^\\s*chapter:?\\s+.*$"
        },
        {
          "name": "markup.heading.section.inform7",
          "match": "(?i)^\\s*section:?\\s+.*$"
        }
      ]
    },
    "tableName": {
      "comment": "A line beginning with 'Table' declares a table; its name is underlined like a heading.",
      "name": "markup.underline.table.name.inform7",
      "match": "(?i)^\\s*table\\b.*$"
    },
    "include": {
      "comment": "Extension inclusions, such as 'Include Basic Screen Effects by Emily Short.'",
      "match": "(?i)^\\s*(include)\\s+(?:(version\\s+[\\w./-]+)\\s+of\\s+)?(.+?)\\s+(by)\\s+(.+?)(\\.)\\s*$",
      "captures": {
        "1": {
          "name": "keyword.control.include.inform7"
        },
        "2": {
          "name": "constant.numeric.version.inform7"
        },
        "3": {
          "name": "entity.name.extension.inform7"
        },
        "4": {
          "name": "keyword.control.include.inform7"
        },
        "5": {
          "name": "entity.name.author.inform7"
        },
        "6": {
          "name": "punctuation.terminator.inform7"
        }
      }
    },
    "inform6Inclusion": {
      "comment": "Inform 6 code between (- and -) is coloured by the Inform 6 grammar. (+ ... +) inside it returns to Inform 7 and is handled by an injection grammar.",
      "name": "meta.embedded.inform6",
      "begin": "\\(-",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.inform7"
        }
      },
      "end": "-\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.inform7"
        }
      },
      "patterns": [
        {
          "include": "source.inform6"
        }
      ]
    },
    "preformInclusion": {
      "comment": "Preform (Inform's grammar-definition syntax) also uses (- -). Mark it with a [preform] comment so it is coloured as Preform, not Inform 6.",
      "name": "meta.embedded.preform",
      "begin": "(\\[preform\\])(\\(-)",
      "beginCaptures": {
        "1": {
          "name": "comment.block.marker.inform7"
        },
        "2": {
          "name": "punctuation.section.embedded.begin.inform7"
        }
      },
      "end": "-\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.inform7"
        }
      },
      "patterns": [
        {
          "include": "source.preform"
        }
      ]
    },
    "javascriptCommand": {
      "comment": "A text preceded by the comment [js] is a Vorple JavaScript command and gets JavaScript colouring.",
      "begin": "(\\[js\\])(\")",
      "beginCaptures": {
        "1": {
          "name": "comment.block.marker.inform7"
        },
        "2": {
          "name": "string.quoted.double.inform7 punctuation.definition.string.begin.inform7"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "string.quoted.double.inform7 punctuation.definition.string.end.inform7"
        }
      },
      "contentName": "meta.embedded.js",
      "patterns": [
        {
          "include": "#javascript"
        }
      ]
    },
    "javascriptExecution": {
      "comment": "Vorple's 'execute JavaScript command' phrase takes JavaScript in a text.",
      "begin": "(?i)execute\\s+javascript\\s+(?:command|code)\\s+(\")",
      "beginCaptures": {
        "1": {
          "name": "string.quoted.double.inform7 punctuation.definition.string.begin.inform7"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "string.quoted.double.inform7 punctuation.definition.string.end.inform7"
        }
      },
      "contentName": "meta.embedded.js",
      "patterns": [
        {
          "include": "#javascript"
        }
      ]
    },
    "javascript": {
      "comment": "A small JavaScript grammar for code embedded in Inform 7 text. Double quotes cannot appear (they would end the text), and Inform substitutions still apply.",
      "patterns": [
        {
          "name": "invalid.illegal.text.substitution.inform7",
          "match": "\\]|\\[(?=\")"
        },
        {
          "include": "#textSubstitution"
        },
        {
          "comment": "A line comment would swallow the closing quote.",
          "name": "invalid.illegal.comment.js",
          "match": "//.*$"
        },
        {
          "name": "invalid.illegal.string.js",
          "match": "'(?=\")"
        },
        {
          "name": "string.quoted.single.js",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.js"
            }
          },
          "end": "(')|([^\"]?)(?=\")",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.string.end.js"
            },
            "2": {
              "name": "invalid.illegal.string.js"
            }
          },
          "patterns": [
            {
              "include": "#javascriptString"
            }
          ]
        },
        {
          "name": "keyword.control.js",
          "match": "\\b(await|break|case|catch|continue|default|do|else|finally|for|goto|if|return|switch|throw|try|while|with|yield)\\b"
        },
        {
          "name": "keyword.operator.expression.js",
          "match": "\\b(delete|in|instanceof|new|typeof|void)\\b"
        },
        {
          "name": "keyword.other.js",
          "match": "\\b(debugger)\\b"
        },
        {
          "name": "constant.language.js",
          "match": "\\b(false|Infinity|NaN|true|undefined)\\b"
        },
        {
          "name": "storage.type.js",
          "match": "\\b(class|const|function|interface|let|var)\\b"
        },
        {
          "name": "storage.modifier.js",
          "match": "\\b(extends|private|protected|public|static)\\b"
        },
        {
          "name": "variable.language.js",
          "match": "\\b(arguments|null|this)\\b"
        },
        {
          "name": "support.class.js",
          "match": "\\b(Array|console|Date|Math|Number|Object|String)\\b"
        },
        {
          "name": "constant.numeric.integer.js",
          "match": "\\b\\d+\\b"
        },
        {
          "name": "entity.name.function.js",
          "match": "(\\$|\\b[a-zA-Z_])[\\w\\$]*(?=\\s*\\()"
        },
        {
          "name": "variable.other.js",
          "match": "(\\$|\\b[a-zA-Z_])[\\w\\$]*"
        }
      ]
    },
    "javascriptString": {
      "patterns": [
        {
          "name": "invalid.illegal.text.substitution.inform7",
          "match": "\\]|\\[(?=\")"
        },
        {
          "include": "#textSubstitution"
        },
        {
          "comment": "Octal escapes are not allowed in strict mode.",
          "name": "invalid.illegal.escape.js",
          "match": "\\\\(?:[1-7][0-7]{0,2}|[0-7]{2,3})"
        },
        {
          "name": "constant.character.escape.js",
          "match": "\\\\(?:x[a-fA-F0-9]{2}|u[a-fA-F0-9]{4}|u\\{([0-9a-fA-F]{1,})\\}|[^\" ])"
        }
      ]
    }
  }
}
