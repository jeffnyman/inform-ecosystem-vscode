{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "source.inform6",
  "name": "Inform 6",
  "patterns": [
    {
      "include": "#optionComment"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#routine"
    },
    {
      "include": "#embeddedRoutine"
    },
    {
      "include": "#object"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#directive"
    },
    {
      "include": "#action"
    },
    {
      "include": "#constant"
    },
    {
      "include": "#javascriptExecution"
    },
    {
      "include": "#support"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#variable"
    },
    {
      "include": "#class"
    }
  ],
  "repository": {
    "optionComment": {
      "comment": "A comment starting !% at the top of a file holds ICL commands (compiler switches).",
      "name": "keyword.other.directive.icl.inform6",
      "match": "^!%.*$"
    },
    "comment": {
      "name": "comment.line.bang.inform6",
      "match": "(!).*$",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.inform6"
        }
      }
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.inform6",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.inform6"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.inform6"
            }
          },
          "patterns": [
            {
              "include": "#printingVariable"
            },
            {
              "include": "#escapeSequence"
            }
          ]
        },
        {
          "comment": "Single-quoted dictionary words. Inform 6 allows word endings like 'pears//p' (plural) and 'in//' (one-letter words).",
          "name": "string.quoted.single.dictionary.inform6",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.inform6"
            }
          },
          "end": "(//(?:p)?)?(')",
          "endCaptures": {
            "1": {
              "name": "constant.character.escape.dictionary.inform6"
            },
            "2": {
              "name": "punctuation.definition.string.end.inform6"
            }
          },
          "patterns": [
            {
              "include": "#escapeSequence"
            }
          ]
        }
      ]
    },
    "printingVariable": {
      "comment": "Inform has 32 printing variables @00 to @31; strings may also use @(n) and @(name) forms.",
      "patterns": [
        {
          "name": "variable.other.printing.inform6",
          "match": "@(0[0-9]|1[0-9]|2[0-9]|3[0-1])"
        },
        {
          "name": "variable.other.printing.inform6",
          "match": "@\\([0-9]+\\)"
        },
        {
          "name": "variable.other.printing.inform6",
          "match": "@\\([a-zA-Z_]\\w*\\)"
        }
      ]
    },
    "escapeSequence": {
      "patterns": [
        {
          "comment": "Six hexadecimal characters is the limit for a Unicode escape.",
          "name": "invalid.illegal.escape.inform6",
          "match": "@\\{[0-9a-fA-F]{7,}\\}"
        },
        {
          "comment": "Any Unicode character can be placed in text by quoting its value in hexadecimal.",
          "name": "constant.character.escape.inform6",
          "match": "@\\{[0-9a-fA-F]{1,6}\\}"
        },
        {
          "comment": "@@ followed by a decimal number is the ZSCII character of that value; accented characters use a single @ with a mnemonic.",
          "name": "constant.character.escape.inform6",
          "match": "\\^|~|\\\\|@(@\\d{1,3}|[\\^`:][aeiouAEIOU]|:y|'[aeiouyAEIOUY]|c[cC]|~[anoANO]|/[oO]|o[aA]|ss|oe|ae|OE|AE|th|Th|et|Et|LL|!!|\\?\\?|<<|>>)"
        },
        {
          "comment": "An escape character with nothing valid after it. A literal @ must be written @@64.",
          "name": "invalid.illegal.escape.inform6",
          "match": "@"
        }
      ]
    },
    "routine": {
      "comment": "A routine at the start of a line: [ Name arg1 arg2; ... ];",
      "name": "meta.routine.inform6",
      "begin": "^\\s*\\[",
      "end": "\\]",
      "captures": {
        "0": {
          "name": "keyword.other.directive.routine.inform6"
        }
      },
      "patterns": [
        {
          "include": "#routineHeader"
        },
        {
          "include": "#routineBody"
        }
      ]
    },
    "embeddedRoutine": {
      "comment": "A routine embedded in an object property, such as before [; ... ], has no name.",
      "name": "meta.routine.embedded.inform6",
      "begin": "\\[",
      "end": "\\]",
      "captures": {
        "0": {
          "name": "keyword.other.directive.routine.inform6"
        }
      },
      "patterns": [
        {
          "include": "#embeddedRoutineHeader"
        },
        {
          "include": "#routineBody"
        }
      ]
    },
    "routineHeader": {
      "begin": "([a-zA-Z_]\\w*)\\b",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.inform6"
        }
      },
      "end": "(?=;)",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "name": "variable.parameter.inform6",
          "match": "\\b[a-zA-Z_]\\w*\\b"
        }
      ]
    },
    "embeddedRoutineHeader": {
      "begin": "(?=[a-zA-Z_])",
      "end": "(?=;)",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "name": "variable.parameter.inform6",
          "match": "\\b[a-zA-Z_]\\w*\\b"
        }
      ]
    },
    "routineBody": {
      "begin": "(?=;)",
      "end": "(?=\\])",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "include": "#keyword"
        },
        {
          "comment": "Inside a routine, Object and Class are classes in expressions (x ofclass Object), so classes take precedence over directives here.",
          "include": "#class"
        },
        {
          "include": "#directive"
        },
        {
          "include": "#action"
        },
        {
          "include": "#constant"
        },
        {
          "include": "#javascriptExecution"
        },
        {
          "include": "#support"
        },
        {
          "include": "#operator"
        },
        {
          "include": "#variable"
        },
        {
          "include": "#class"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.inform6",
          "match": "\\b(break|continue|default|do|else|for|give|if|inversion|jump|new_line|objectloop|print|print_ret|quit|remove|return|rfalse|rtrue|spaces|string|switch|until|while)\\b"
        },
        {
          "comment": "Statements that drive the screen model or the save system.",
          "name": "keyword.control.zmachine.inform6",
          "match": "\\b(box|font\\s+(on|off)|read|restore|save|style\\s+(roman|bold|underline|reverse|fixed))\\b"
        },
        {
          "match": "\\b(move)\\s+([a-zA-Z_]\\w*)\\s+(to)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.inform6"
            },
            "2": {
              "patterns": [
                {
                  "include": "#variable"
                }
              ]
            },
            "3": {
              "name": "keyword.control.inform6"
            }
          }
        }
      ]
    },
    "action": {
      "comment": "<Action noun second> runs an action; <<Action>> runs it and returns true.",
      "begin": "(<<?)\\s*([a-zA-Z_]\\w*)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.action.inform6"
        },
        "2": {
          "name": "support.function.action.inform6"
        }
      },
      "end": ">>?",
      "endCaptures": {
        "0": {
          "name": "keyword.control.action.inform6"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "include": "#constant"
        },
        {
          "include": "#support"
        },
        {
          "include": "#variable"
        }
      ]
    },
    "directive": {
      "patterns": [
        {
          "comment": "Declarations that name something: the name gets its own scope.",
          "match": "(?i)(\\b|#)(Constant)\\s+([a-zA-Z_]\\w*)",
          "captures": {
            "2": {
              "name": "keyword.other.directive.inform6"
            },
            "3": {
              "name": "entity.name.constant.inform6"
            }
          }
        },
        {
          "match": "(?i)(\\b|#)(Global)\\s+([a-zA-Z_]\\w*)",
          "captures": {
            "2": {
              "name": "keyword.other.directive.inform6"
            },
            "3": {
              "name": "variable.other.global.inform6"
            }
          }
        },
        {
          "match": "(?i)(\\b|#)(Attribute)\\s+([a-zA-Z_]\\w*)",
          "captures": {
            "2": {
              "name": "keyword.other.directive.inform6"
            },
            "3": {
              "name": "entity.name.attribute.inform6"
            }
          }
        },
        {
          "match": "(?i)(\\b|#)(Property)\\s+(additive\\s+)?(?!alias\\b)([a-zA-Z_]\\w*)",
          "captures": {
            "2": {
              "name": "keyword.other.directive.inform6"
            },
            "3": {
              "name": "keyword.other.directive.inform6"
            },
            "4": {
              "name": "entity.name.property.inform6"
            }
          }
        },
        {
          "comment": "Directives are case insensitive and may be written with a leading # sign.",
          "name": "keyword.other.directive.inform6",
          "match": "(?i)(\\b|#)(Abbreviate|Attribute|Class|Constant|Default|Dictionary|End|Endif|Extend|Fake_action|Global|Ifdef|Iffalse|Ifndef|Ifnot|Iftrue|Include|Lowstring|Message(\\s+(error|fatalerror|warning))?|Object|Origsource|Property(\\s+additive)?|Release|Replace|Serial|Statusline\\s+(time|score)|Stub|System_file|Trace|Undef|Verb(\\s+meta)?|Zcharacter(\\s+table)?)\\b"
        },
        {
          "comment": "Directives that are obsolete: Inform 5 placement, module linking, and settings now given as ICL switches.",
          "name": "invalid.deprecated.directive.inform6",
          "match": "(?i)(\\b|#)(Ifv3|Ifv5|Import|Link|Nearby|Switches|Version)\\b"
        },
        {
          "comment": "first, last and only go with Extend; alias goes with Property or Attribute.",
          "name": "keyword.other.directive.modifier.inform6",
          "match": "\\b(alias|first|last|only)\\b"
        },
        {
          "match": "(?i)\\b(Array)\\s+([a-zA-Z_]\\w*)\\s+(static\\s+)?(-->|->|buffer\\b|string\\b|table\\b)",
          "captures": {
            "1": {
              "name": "keyword.other.directive.inform6"
            },
            "2": {
              "name": "variable.other.array.inform6"
            },
            "3": {
              "name": "keyword.other.directive.inform6"
            },
            "4": {
              "name": "keyword.other.directive.inform6"
            }
          }
        }
      ]
    },
    "constant": {
      "patterns": [
        {
          "name": "constant.numeric.integer.binary.inform6",
          "match": "\\$\\$[01]+\\b"
        },
        {
          "comment": "Glulx floating-point constants: $+1.5, $-2.0e+3, $+1e10.",
          "name": "constant.numeric.float.inform6",
          "match": "\\$[\\+-]\\d+(\\.\\d+)?(e[\\+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.hexadecimal.inform6",
          "match": "\\$[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.integer.inform6",
          "match": "(\\b|-)\\d+\\b"
        },
        {
          "comment": "NULL is used by the library but is not formally documented.",
          "name": "constant.language.inform6",
          "match": "\\b(false|nothing|NULL|true)\\b"
        },
        {
          "name": "invalid.illegal.character.inform6",
          "match": "'@\\{[0-9a-fA-F]{7,}\\}'|'@'"
        },
        {
          "name": "constant.numeric.integer.character.inform6",
          "match": "'(@(\\{[0-9a-fA-F]{1,6}\\}|[\\^`:][aeiouAEIOU]|:y|'[aeiouyAEIOUY]|c[cC]|~[anoANO]|/[oO]|o[aA]|ss|oe|OE|ae|AE|th|Th|et|Et|LL|!!|\\?\\?|<<|>>)|[^@])'"
        }
      ]
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.increment.inform6",
          "match": "\\+\\+"
        },
        {
          "name": "keyword.operator.decrement.inform6",
          "match": "--"
        },
        {
          "name": "keyword.operator.array.inform6",
          "match": "-->|->"
        },
        {
          "name": "keyword.operator.comparison.inform6",
          "match": "==|~=|<=|<|>=|>"
        },
        {
          "name": "keyword.operator.logical.inform6",
          "match": "&&|\\|\\||~~"
        },
        {
          "name": "keyword.operator.arithmetic.inform6",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.assignment.inform6",
          "match": "="
        },
        {
          "name": "keyword.operator.bitwise.inform6",
          "match": "&|\\||~"
        },
        {
          "comment": "Condition operators, and the segment words of an object definition (class, private, with; has serves as both).",
          "name": "keyword.operator.expression.inform6",
          "match": "\\b(class|has|hasnt|in|notin|ofclass|or|private|provides|with)\\b"
        },
        {
          "name": "punctuation.accessor.inform6",
          "match": "\\.&|\\.#|\\.|::"
        },
        {
          "name": "punctuation.separator.comma.inform6",
          "match": ","
        }
      ]
    },
    "object": {
      "comment": "Object and class-instance declarations, which by convention start in column 0 (property lines are indented). The first word is Object, Nearby, or a class name; -> arrows give relative placement. Directive words are excluded so that 'Constant Story \"...\"' is not read as a declaration.",
      "patterns": [
        {
          "match": "^(?!(?i:Abbreviate|Array|Attribute|Constant|Default|Dictionary|End|Endif|Extend|Fake_action|Global|Ifdef|Iffalse|Ifndef|Ifnot|Iftrue|Import|Include|Link|Lowstring|Message|Origsource|Property|Release|Replace|Serial|Statusline|Stub|Switches|System_file|Trace|Undef|Verb|Version|Zcharacter)\\b)([a-zA-Z_]\\w*)\\s*((?:->)(?:\\s*->)*)\\s*([a-zA-Z_]\\w*)?\\s*(\"[^\"]*?\")?\\s*([a-zA-Z_]\\w*)?",
          "captures": {
            "1": {
              "patterns": [
                {
                  "include": "#objectKind"
                }
              ]
            },
            "2": {
              "name": "storage.modifier.placement.inform6"
            },
            "3": {
              "name": "entity.name.object.inform6"
            },
            "4": {
              "name": "string.quoted.double.inform6",
              "patterns": [
                {
                  "include": "#printingVariable"
                },
                {
                  "include": "#escapeSequence"
                }
              ]
            },
            "5": {
              "name": "invalid.illegal.object.inform6"
            }
          }
        },
        {
          "comment": "Absolute placement: Kind name \"short name\" parent. A quoted short name is required here so that ordinary statements are not mistaken for declarations.",
          "match": "^(?!(?i:Abbreviate|Array|Attribute|Constant|Default|Dictionary|End|Endif|Extend|Fake_action|Global|Ifdef|Iffalse|Ifndef|Ifnot|Iftrue|Import|Include|Link|Lowstring|Message|Origsource|Property|Release|Replace|Serial|Statusline|Stub|Switches|System_file|Trace|Undef|Verb|Version|Zcharacter)\\b)([a-zA-Z_]\\w*)\\s+([a-zA-Z_]\\w*)?\\s*(\"[^\"]*?\")\\s*([a-zA-Z_]\\w*)?",
          "captures": {
            "1": {
              "patterns": [
                {
                  "include": "#objectKind"
                }
              ]
            },
            "2": {
              "name": "entity.name.object.inform6"
            },
            "3": {
              "name": "string.quoted.double.inform6",
              "patterns": [
                {
                  "include": "#printingVariable"
                },
                {
                  "include": "#escapeSequence"
                }
              ]
            },
            "4": {
              "name": "variable.other.parent.inform6"
            }
          }
        }
      ]
    },
    "objectKind": {
      "patterns": [
        {
          "name": "keyword.other.directive.inform6",
          "match": "(?i)\\b(Object|Class)\\b"
        },
        {
          "comment": "Nearby is the Inform 5 way of writing Object ->.",
          "name": "invalid.deprecated.directive.inform6",
          "match": "(?i)\\bNearby\\b"
        },
        {
          "name": "entity.name.type.class.inform6",
          "match": "\\b[a-zA-Z_]\\w*\\b"
        }
      ]
    },
    "support": {
      "patterns": [
        {
          "include": "#supportFunction"
        },
        {
          "include": "#supportConstant"
        },
        {
          "include": "#supportVariable"
        },
        {
          "include": "#supportOpcode"
        }
      ]
    },
    "supportFunction": {
      "patterns": [
        {
          "comment": "Library and built-in functions.",
          "name": "support.function.library.inform6",
          "match": "\\b(Achieved|AddToScope|AfterRoutines|AllowPushDir|Banner|call|Cap|Centre|ChangePlayer|child|children|CommonAncestor|copy|create|destroy|DictionaryLookup|GetGNAOfObject|HasLightSource|IndirectlyContains|IsSeeThrough|Length|Locale|LoopOverScope|LowerCase|LTI_Insert|metaclass|MoveFloatingObjects|NextEntry|NextWord|NextWordStopped|NounDomain|ObjectIsUntouchable|OffersLight|parent|ParseToken|PlaceInScope|PlayerTo|print_to_array|PrintCapitalised|PrintOrRun|PrintOrRunVal|PrintToBuffer|PronounNotice|PronounValue|random|recreate|remaining|ScopeWithin|SetColour|SetPronoun|SetTime|sibling|StartDaemon|StartTimer|StopDaemon|StopTimer|TestScope|TryNumber|UnsignedCompare|UpperCase|WordAddress|WordInProperty|WordLength|WriteListFrom|YesOrNo)\\b"
        },
        {
          "name": "support.function.glulx.inform6",
          "match": "\\b(ClearScreen|DecimalNumber|DrawStatusLine|glk|KeyCharPrimitive|KeyDelay|MainWindow|MoveCursor|PrintAnything|PrintAnyToArray|ScreenHeight|ScreenWidth|StatusLineHeight)\\b"
        },
        {
          "comment": "Library-defined properties.",
          "name": "support.function.property.inform6",
          "match": "\\b(add_to_scope|after|article|articles|before|before_implicit|cant_go|capacity|compass_look|d_to|daemon|describe|description|door_dir|door_to|e_to|each_turn|ext_initialise|ext_messages|found_in|grammar|in_to|initial|inside_description|invent|life|list_together|n_to|name|ne_to|number|nw_to|orders|out_to|parse_name|plural|react_after|react_before|s_to|se_to|short_name|short_name_indef|sw_to|time_left|time_out|u_to|w_to|when_closed|when_off|when_on|when_open|with_key)\\b"
        }
      ]
    },
    "supportConstant": {
      "patterns": [
        {
          "name": "support.constant.library.inform6",
          "match": "\\b(LIBRARY_ENGLISH|LIBRARY_GRAMMAR|LIBRARY_PARSER|LIBRARY_VERBLIB|LIBRARY_VERSION)\\b"
        },
        {
          "name": "support.constant.listingstyle.inform6",
          "match": "\\b(ALWAYS_BIT|CONCEAL_BIT|DEFART_BIT|ENGLISH_BIT|FULLINV_BIT|INDENT_BIT|ISARE_BIT|NEWLINE_BIT|NOARTICLE_BIT|PARTINV_BIT|RECURSE_BIT|TERSE_BIT|WORKFLAG_BIT)\\b"
        },
        {
          "name": "support.constant.gprresult.inform6",
          "match": "\\b(GPR_FAIL|GPR_MULTIPLE|GPR_NUMBER|GPR_PREPOSITION|GPR_REPARSE)\\b"
        },
        {
          "name": "support.constant.grammartoken.inform6",
          "match": "\\b(CREATURE_TOKEN|HELD_TOKEN|MULTI_TOKEN|MULTIEXCEPT_TOKEN|MULTIHELD_TOKEN|MULTIINSIDE_TOKEN|NUMBER_TOKEN|NOUN_TOKEN|ELEMENTARY_TT|SCOPE_TT|REPARSE_CODE)\\b"
        },
        {
          "name": "support.constant.scopereason.inform6",
          "match": "\\b(EACHTURN_REASON|LOOPOVERSCOPE_REASON|PARSING_REASON|REACT_AFTER_REASON|REACT_BEFORE_REASON|TALKING_REASON|TESTSCOPE_REASON)\\b"
        },
        {
          "name": "support.constant.parsererror.inform6",
          "match": "\\b(ANIMA_PE|ASKSCOPE_PE|CANTSEE_PE|EXCEPT_PE|ITGONE_PE|JUNKAFTER_PE|MMULTI_PE|MULTI_PE|NOTHELD_PE|NOTHING_PE|NUMBER_PE|SCENERY_PE|STUCK_PE|TOOFEW_PE|TOOLIT_PE|UPTO_PE|VAGUE_PE|VERB_PE)\\b"
        },
        {
          "name": "support.constant.colour.inform6",
          "match": "\\b(CLR_AZURE|CLR_BLACK|CLR_BLUE|CLR_CYAN|CLR_DEFAULT|CLR_GREEN|CLR_MAGENTA|CLR_PURPLE|CLR_RED|CLR_WHITE|CLR_YELLOW|WIN_ALL|WIN_MAIN|WIN_STATUS)\\b"
        },
        {
          "name": "support.constant.vm.inform6",
          "match": "\\b(TARGET_GLULX|TARGET_ZCODE|WORDSIZE)\\b"
        },
        {
          "name": "support.constant.glulx.inform6",
          "match": "\\b(FLOAT_INFINITY|FLOAT_NINFINITY|FLOAT_NAN|GG_MAINWIN_ROCK|GG_QUOTEWIN_ROCK|GG_STATUSWIN_ROCK)\\b"
        }
      ]
    },
    "supportVariable": {
      "patterns": [
        {
          "name": "support.variable.library.inform6",
          "match": "\\b(c_style|compass|d_obj|deadflag|e_obj|etype|in_obj|keep_silent|multiple_object|n_obj|ne_obj|notify_mode|nw_obj|out_obj|parsed_number|parser_action|parser_inflection|parser_one|parser_two|s_obj|score|se_obj|selfobj|sw_obj|sys_statusline_flag|take_flag|thedark|turns|u_obj|verb_word|verb_wordnum|w_obj|wn)\\b"
        },
        {
          "name": "support.variable.glulx.inform6",
          "match": "\\b(gg_arguments|gg_statuswin_cursize|gg_statuswin_size)\\b"
        },
        {
          "comment": "Library actions, in the three groups of the Designer's Manual.",
          "name": "support.variable.action.group1.inform6",
          "match": "\\b(FullScore|LMode1|LMode2|LMode3|Miscellany|NotifyOff|NotifyOn|Objects|Places|PluralFound|Prompt|Pronouns|Quit|Restart|Restore|Save|Score|ScriptOff|ScriptOn|TheSame|Verify|Version)\\b"
        },
        {
          "name": "support.variable.action.group2.inform6",
          "match": "\\b(Close|Disrobe|Drop|Eat|Empty|EmptyT|Enter|Examine|Exit|GetOff|Go|GoIn|Insert|Inv|InvTall|InvWide|LetGo|Lock|Look|Open|PutOn|Receive|Remove|Search|SwitchOff|SwitchOn|Take|Transfer|Unlock|Wait|Wear)\\b"
        },
        {
          "name": "support.variable.action.group3.inform6",
          "match": "\\b(Answer|Ask|AskFor|AskTo|Attack|Blow|Burn|Buy|Climb|Consult|Cut|Dig|Drink|Fill|Give|Jump|JumpIn|JumpOn|JumpOver|Kiss|Listen|LookUnder|Mild|No|NotUnderstood|Order|Pray|Pull|Push|PushDir|Rub|Set|SetTo|Show|Sing|Sleep|Smell|Sorry|Squeeze|Strong|Swim|Swing|Taste|Tell|Think|ThrowAt|ThrownAt|Tie|Touch|Turn|VagueGo|Wake|WakeOther|Wave|WaveHands|Yes)\\b"
        },
        {
          "name": "support.variable.attribute.inform6",
          "match": "\\b(absent|animate|clothing|concealed|container|door|edible|enterable|female|general|light|lockable|locked|male|moved|neuter|on|open|openable|pluralname|proper|scenery|scored|static|supporter|switchable|talkable|transparent|visited|workflag|worn)\\b"
        }
      ]
    },
    "supportOpcode": {
      "patterns": [
        {
          "name": "support.function.opcode.inform6",
          "match": "@(catch|pull|push|quit|restore|save|throw)\\b"
        },
        {
          "name": "support.function.opcode.zmachine.inform6",
          "match": "@(aread|buffer_mode|check_unicode|encode_text|erase_window|input_stream|loadb|output_stream|print_table|print_unicode|read_char|set_color|set_cursor|set_window|sound_effect|split_window|tokenise)\\b"
        },
        {
          "name": "support.function.opcode.glulx.inform6",
          "match": "@(accelfunc|accelparam|acos|add|aload|aloadb|aloadbit|aloads|asin|astore|astoreb|astorebit|astores|atan|atan2|binarysearch|bitand|bitnot|bitor|bitxor|call|callf|callfi|callfii|callfiii|ceil|copy|copyb|copys|cos|debugtrap|div|exp|fadd|fdiv|floor|fmod|fmul|fsub|ftonumn|ftonumz|gestalt|getiosys|getmemsize|getstringtbl|glk|jeq|jfeq|jfge|jfgt|jfle|jflt|jfne|jge|jgeu|jgt|jgtu|jisinf|jisnan|jle|jleu|jltu|jne|jlt|jnz|jump|jumpabs|jz|linearsearch|linkedsearch|log|malloc|mcopy|mfree|mod|mul|mzero|neg|nop|numtof|pow|protect|random|restart|restoreundo|return|saveundo|setiosys|setmemsize|setrandom|setstringtbl|sexb|sexs|shiftl|sin|sqrt|sshiftr|stkcopy|stkcount|stkpeek|stkroll|stkswap|streamchar|streamnum|streamstr|streamunichar|sub|tailcall|tan|ushiftr|verify)\\b"
        },
        {
          "comment": "Custom Glulx opcodes written as @\"S1:123\".",
          "name": "support.function.opcode.glulx.custom.inform6",
          "match": "@\"[SBR]*\\d:\\d+\""
        }
      ]
    },
    "variable": {
      "patterns": [
        {
          "comment": "Actions referred to as values use ## notation.",
          "name": "variable.other.actiontype.inform6",
          "match": "##[a-zA-Z_]\\w*\\b"
        },
        {
          "name": "variable.language.inform6",
          "match": "\\b(action|action_to_be|actor|consult_from|consult_words|indef_mode|inp1|inp2|inventory_stage|lm_n|lm_o|location|noun|player|real_location|scope_reason|scope_stage|second|self|standard_interpreter|the_time|vague_word|vague_obj|verb_word|verb_wordnum|herobj|himobj|itobj|et_flag|listing_together|lookmode|receive_action|special_number)\\b"
        },
        {
          "name": "variable.language.grammartoken.inform6",
          "match": "\\b(creature|held|multi|multiexcept|multiheld|multiinside|number|scope|topic)\\b"
        },
        {
          "name": "variable.language.glulx.inform6",
          "match": "\\b(gg_event|gg_mainwin|gg_statuswin)\\b"
        }
      ]
    },
    "class": {
      "patterns": [
        {
          "name": "support.class.library.inform6",
          "match": "\\b(CompassDirection|Menu|Option|SwitchOption)\\b"
        },
        {
          "name": "support.class.meta.inform6",
          "match": "\\b(Class|Object|Routine|String)\\b"
        }
      ]
    },
    "javascriptExecution": {
      "comment": "Vorple: strings passed to VorpleExecuteJavaScriptCommand and BuildCommand are JavaScript.",
      "begin": "\\b(VorpleExecuteJavaScriptCommand|BuildCommand)(\\()",
      "beginCaptures": {
        "1": {
          "name": "support.function.vorple.inform6"
        },
        "2": {
          "name": "punctuation.section.arguments.begin.inform6"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.arguments.end.inform6"
        }
      },
      "patterns": [
        {
          "include": "#javascriptCommand"
        },
        {
          "include": "#support"
        },
        {
          "include": "#variable"
        },
        {
          "include": "#operator"
        }
      ]
    },
    "javascriptCommand": {
      "name": "string.quoted.double.inform6",
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.inform6"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.inform6"
        }
      },
      "contentName": "meta.embedded.js",
      "patterns": [
        {
          "include": "#javascript"
        }
      ]
    },
    "javascript": {
      "comment": "A small JavaScript grammar for code inside an Inform 6 string. Double quotes cannot appear inside it.",
      "patterns": [
        {
          "name": "invalid.illegal.comment.js",
          "match": "//[^\"]*"
        },
        {
          "name": "string.quoted.single.js",
          "match": "'"
        },
        {
          "name": "keyword.control.js",
          "match": "\\b(await|break|case|catch|continue|default|do|else|finally|for|goto|if|return|switch|throw|try|while|with|yield)\\b"
        },
        {
          "name": "keyword.operator.expression.js",
          "match": "\\b(delete|in|instanceof|new|typeof|void)\\b"
        },
        {
          "name": "keyword.other.js",
          "match": "\\b(debugger)\\b"
        },
        {
          "name": "constant.language.js",
          "match": "\\b(false|Infinity|NaN|true|undefined)\\b"
        },
        {
          "name": "storage.type.js",
          "match": "\\b(class|const|function|interface|let|var)\\b"
        },
        {
          "name": "storage.modifier.js",
          "match": "\\b(extends|private|protected|public|static)\\b"
        },
        {
          "name": "variable.language.js",
          "match": "\\b(arguments|null|this)\\b"
        },
        {
          "name": "support.class.js",
          "match": "\\b(Array|console|Date|Math|Number|Object|String)\\b"
        },
        {
          "name": "constant.numeric.integer.js",
          "match": "\\b\\d+\\b"
        },
        {
          "name": "entity.name.function.js",
          "match": "(\\$|\\b[a-zA-Z_])[\\w\\$]*(?=\\s*\\()"
        },
        {
          "name": "variable.other.js",
          "match": "(\\$|\\b[a-zA-Z_])[\\w\\$]*"
        },
        {
          "name": "invalid.illegal.escape.js",
          "match": "\\\\(?:[1-7][0-7]{0,2}|[0-7]{2,3})"
        },
        {
          "name": "constant.character.escape.js",
          "match": "\\\\(?:x[a-fA-F0-9]{2}|u[a-fA-F0-9]{4}|u\\{([0-9a-fA-F]{1,})\\}|[^\" ])"
        }
      ]
    }
  }
}
